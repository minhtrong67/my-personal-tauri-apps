{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Launcher",
  "version": "0.1.0",
  "identifier": "dev.minhtrong67.claude-launcher",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claude Launcher",
        "width": 900,
        "height": 680,
        "minWidth": 520,
        "minHeight": 520,
        "center": true,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "minhtrong67",
    "copyright": "Copyright (c) 2026 minhtrong67",
    "category": "Utility",
    "shortDescription": "Open and close Chrome profiles straight into claude.ai",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Vietnamese", "English"],
        "installerIcon": "icons/setup.ico",
        "uninstallerIcon": "icons/uninstall.ico",
        "headerImage": "icons/nsis-header.bmp",
        "uninstallerHeaderImage": "icons/nsis-uninstall-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      }
    }
  }
}
