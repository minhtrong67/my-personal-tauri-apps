{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MP3 Downloader",
  "version": "0.3.2",
  "identifier": "com.myproject.mp3downloader",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MP3 Downloader",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "minhtrong67",
    "copyright": "© minhtrong67",
    "shortDescription": "Tải nhạc MP3 từ YouTube, TikTok, Spotify",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/installer.ico",
        "uninstallerIcon": "icons/uninstaller.ico"
      }
    }
  }
}
