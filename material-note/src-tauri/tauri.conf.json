{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Material Note",
  "version": "1.0.0",
  "identifier": "com.minhtrong67.material-note",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Material Note",
        "width": 1040,
        "height": 700,
        "minWidth": 520,
        "minHeight": 360,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "minhtrong67",
    "copyright": "Copyright (c) 2026 minhtrong67",
    "category": "Productivity",
    "shortDescription": "Fast, beautiful notepad with Material Design 3.",
    "longDescription": "Material Note is a lightweight tabbed notepad with find & replace, themes, custom colors and English/Vietnamese support. Created by minhtrong67 with the support of Claude.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["txt", "log", "md"],
        "name": "Text document",
        "description": "Plain text document",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/installer/installer.ico",
        "headerImage": "icons/installer/nsis-header.bmp",
        "sidebarImage": "icons/installer/nsis-sidebar.bmp",
        "installMode": "currentUser"
      },
      "wix": {
        "bannerPath": "icons/installer/wix-banner.bmp",
        "dialogImagePath": "icons/installer/wix-dialog.bmp"
      }
    }
  }
}
