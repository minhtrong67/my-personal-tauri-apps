{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screenshot Beautifier",
  "version": "1.0.0",
  "identifier": "com.minhtrong67.screenshotbeautifier",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Screenshot Beautifier", "width": 1320, "height": 840, "minWidth": 640, "minHeight": 480, "center": true, "decorations": false, "shadow": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "minhtrong67",
    "copyright": "Copyright (c) 2026 minhtrong67",
    "shortDescription": "Make screenshots look great",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico", "uninstallerIcon": "icons/icon.ico" } }
  }
}
