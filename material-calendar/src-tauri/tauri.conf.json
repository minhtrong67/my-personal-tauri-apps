{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calendar",
  "version": "1.0.0",
  "identifier": "com.minhtrong67.calendar",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Calendar",
        "width": 1200,
        "height": 800,
        "minWidth": 860,
        "minHeight": 580,
        "center": true,
        "visible": false,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "minhtrong67",
    "copyright": "Copyright (c) 2026 minhtrong67",
    "category": "Productivity",
    "shortDescription": "Material Design 3 desktop calendar",
    "longDescription": "A fast, beautiful desktop calendar with month, week, day and agenda views, reminders, recurring events, themes and English/Vietnamese support.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/installer.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "languages": ["English", "Vietnamese"],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    }
  }
}
